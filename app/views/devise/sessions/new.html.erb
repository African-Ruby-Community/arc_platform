<% auth_content = capture do %>
  <%# ── Header strip ── %>
  <div class="arc-hero-ruby px-8 py-8 text-center relative overflow-hidden">
    <figure class="flex justify-center">
      <%= image_tag "sign_up_karate.png",
                    class: "h-64 sm:h-80 w-auto object-contain" %>
    </figure>
    <h1 class="text-white font-extrabold text-2xl mb-1"><%= t('devise.views.sessions.new.title') %></h1>
    <p class="text-white/70 text-sm"><%= t('devise.views.sessions.new.welcome') %></p>
  </div>

  <%# ── Form body ── %>
  <div class="px-8 py-8">
    <% if @turnstile_error %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation text-red-400 flex-shrink-0"></i>
        <span class="text-red-700 text-sm"><%= @turnstile_error %></span>
      </div>
    <% end %>

    <%# GitHub OAuth %>
    <div class="mb-5">
      <%= button_to user_github_omniauth_authorize_path,
          method: :post,
          data: { turbo: false },
          class: "w-full flex items-center justify-center gap-3 h-12 rounded-xl bg-gray-900 hover:bg-gray-800 text-white font-semibold text-sm transition-colors border border-gray-800 cursor-pointer",
          form_class: "w-full" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"/>
        </svg>
        <%= t('devise.views.shared.links.github_sign_in') %>
      <% end %>
      <%= link_to t('devise.views.shared.links.github_sign_in'),
          user_github_omniauth_authorize_path,
          data: { turbo_method: :post },
          class: "hidden",
          aria: { hidden: true } %>
    </div>

    <%# Divider %>
    <div class="relative flex items-center gap-4 mb-5">
      <div class="flex-1 h-px bg-gray-200"></div>
      <span class="text-xs arc-text-faint font-medium whitespace-nowrap"><%= t('devise.views.shared.links.or_divider') %></span>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <%# Email/Password form %>
    <%= simple_form_for(resource, as: resource_name,
        url: session_path(resource_name),
        html: { id: 'new_user', class: 'space-y-4' }) do |f| %>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.sessions.new.email_label') %></label>
        <%= f.input :email,
            placeholder: t('devise.views.sessions.new.email_placeholder'),
            label: false,
            wrapper: false,
            input_html: {
              class: 'arc-input w-full',
              autofocus: true,
              autocomplete: 'email'
            } %>
      </div>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.sessions.new.password_label') %></label>
        <%= f.input :password,
            placeholder: t('devise.views.sessions.new.password_placeholder'),
            label: false,
            wrapper: false,
            input_html: {
              class: 'arc-input w-full',
              autocomplete: 'current-password'
            } %>
      </div>

      <%= render "shared/cloudflare_turnstile" %>

      <div class="pt-2">
        <%= f.button :button, t('devise.views.sessions.new.submit_button'),
            class: 'w-full justify-center text-base py-3.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed',
            disabled: true %>
      </div>
    <% end %>

    <%# Footer links — no GitHub button here, it's already at the top %>
    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
<%= render "devise/shared/auth_card", content: auth_content %>
