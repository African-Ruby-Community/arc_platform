<% auth_content = capture do %>
  <%# ── Header strip ── %>
  <div class="arc-hero-ruby px-8 py-10 text-center">
    <figure class="flex justify-center">
      <%= image_tag "sign_up_karate.png",
                    class: "h-64 sm:h-80 w-auto object-contain" %>
    </figure>

    <h1 class="text-white text-3xl font-extrabold mb-2">
      <%= t('devise.views.registrations.new.title') %>
    </h1>
  </div>

  <%# ── Form body ── %>
  <div class="px-8 py-8">

    <%# GitHub OAuth %>
    <div class="mb-5">
      <%= button_to user_github_omniauth_authorize_path,
                    method: :post,
                    data: { turbo: false },
                    class: "w-full flex items-center justify-center gap-3 h-12 rounded-xl bg-gray-900 hover:bg-gray-800 text-white font-semibold text-sm transition-colors border border-gray-800 cursor-pointer",
                    form_class: "w-full" do %>
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"/>
        </svg>
        <%= t('devise.views.shared.links.github_sign_up') %>
      <% end %>
      <%= link_to t('devise.views.shared.links.github_sign_up'),
                  user_github_omniauth_authorize_path,
                  data: { turbo_method: :post },
                  class: "hidden",
                  aria: { hidden: true } %>
    </div>

    <%# Divider %>
    <div class="relative flex items-center gap-4 mb-5">
      <div class="flex-1 h-px bg-gray-200 dark:bg-slate-700"></div>
      <span class="text-xs arc-text-faint font-medium whitespace-nowrap"><%= t('devise.views.shared.links.or_divider') %></span>
      <div class="flex-1 h-px bg-gray-200 dark:bg-slate-700"></div>
    </div>

    <%# Registration form %>
    <%= simple_form_for(resource, as: resource_name,
                        url: registration_path(resource_name),
                        html: {
                          data: { controller: "bot-detection", bot_detection_target: "form" },
                          class: 'space-y-4'
                        }) do |f| %>

      <% oauth_user = session['devise.github_data'].present? %>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.email_label') %></label>
        <%= f.input :email,
                    placeholder: t('devise.views.registrations.new.email_placeholder'),
                    label: false, wrapper: false,
                    input_html: { class: 'arc-input w-full', autocomplete: 'email', readonly: oauth_user } %>
      </div>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.name_label') %></label>
        <%= f.input :name,
                    placeholder: t('devise.views.registrations.new.name_placeholder'),
                    label: false, wrapper: false,
                    input_html: { class: 'arc-input w-full', autocomplete: 'name', readonly: oauth_user } %>
      </div>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.phone_number_label') %></label>
        <p class="arc-text-faint text-xs mb-1.5"><%= t('devise.views.registrations.new.phone_number_hint') %></p>
        <%= f.input :phone_number,
                    placeholder: t('devise.views.registrations.new.phone_number_placeholder'),
                    label: false, wrapper: false,
                    input_html: { class: 'arc-input w-full', autocomplete: 'phone_number' } %>
      </div>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.chapter_label') %></label>
        <div class="relative">
          <%= select_tag :chapter_id,
                         options_from_collection_for_select(Chapter.all, 'id', 'name'),
                         include_blank: false,
                         class: "arc-input w-full appearance-none pr-10" %>
          <i class="fa-solid fa-chevron-down absolute right-3.5 top-1/2 -translate-y-1/2 arc-text-faint text-xs pointer-events-none"></i>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.github_username_label') %></label>
        <% hint = oauth_user ? "Automatically filled from GitHub" : t('devise.views.registrations.new.github_username_hint') %>
        <p class="arc-text-faint text-xs mb-1.5"><%= hint %></p>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 arc-text-faint text-sm pointer-events-none">@</span>
          <%= f.input :github_username,
                      placeholder: t('devise.views.registrations.new.github_username_placeholder'),
                      label: false, wrapper: false,
                      input_html: { class: 'arc-input w-full pl-8', autocomplete: 'github_username', readonly: oauth_user } %>
        </div>
      </div>

      <% unless oauth_user %>
        <div>
          <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.password_label') %></label>
          <%= f.input :password,
                      placeholder: t('devise.views.registrations.new.password_placeholder'),
                      label: false, wrapper: false,
                      input_html: { class: 'arc-input w-full' } %>
        </div>

        <div>
          <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.registrations.new.password_confirmation_label') %></label>
          <%= f.input :password_confirmation,
                      placeholder: t('devise.views.registrations.new.password_confirmation_placeholder'),
                      label: false, wrapper: false,
                      input_html: { class: 'arc-input w-full' } %>
        </div>
      <% else %>
        <div class="flex items-start gap-3 p-4 bg-green-50 border border-green-200 rounded-xl">
          <i class="fa-solid fa-circle-check text-green-500 mt-0.5 flex-shrink-0"></i>
          <span class="text-green-700 text-sm font-medium">You're signing up with GitHub. No password needed.</span>
        </div>
      <% end %>

      <%= render "shared/cloudflare_turnstile" %>

      <div class="pt-2">
        <%= f.button :button, t('devise.views.registrations.new.submit_button'),
                     class: 'w-full justify-center text-base py-3.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed',
                     disabled: true %>
      </div>
    <% end %>

    <%# Footer links %>
    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
<%= render "devise/shared/auth_card", content: auth_content %>
