<% auth_content = capture do %>
  <%# ── Header strip ── %>
  <div class="arc-hero-ruby px-8 py-8 text-center relative overflow-hidden">
    <figure class="flex justify-center">
      <%= image_tag "sign_up_karate.png",
                    class: "h-64 sm:h-80 w-auto object-contain" %>
    </figure>
    <h1 class="text-white font-extrabold text-2xl mb-1"><%= t('devise.views.passwords.new.title') %></h1>
    <p class="text-white/70 text-sm"><%= t('devise.passwords.message') %></p>
  </div>

  <%# ── Form body ── %>
  <div class="px-8 py-8">
    <%= simple_form_for(resource, as: resource_name,
        url: password_path(resource_name),
        html: { class: 'space-y-4' }) do |f| %>

      <div>
        <label class="block text-sm font-semibold arc-text-base mb-1.5"><%= t('devise.views.passwords.new.email_label') %></label>
        <%= f.input :email,
            placeholder: t('devise.views.passwords.new.email_placeholder'),
            label: false, wrapper: false,
            input_html: { class: 'arc-input w-full', autofocus: true, autocomplete: 'email' } %>
      </div>

      <div class="pt-2">
        <%= f.button :button, t('devise.views.passwords.new.submit_button'),
            class: 'w-full justify-center text-base py-3.5 cursor-pointer' %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>
<%= render "devise/shared/auth_card", content: auth_content %>
