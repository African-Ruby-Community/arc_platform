<div class="min-h-screen py-14 px-4">
  <div class="max-w-2xl mx-auto">

    <%# Back link %>
    <%= link_to built_with_ruby_path, class: "inline-flex items-center gap-2 text-gray-400 hover:text-ruby-600 text-sm mb-8 transition-colors" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i>
      <%= t('companies.new.back_button') %>
    <% end %>

    <%# Card %>
    <div class="arc-auth-card max-w-full">
      <%# Card header %>
      <div class="arc-hero-ruby px-8 py-8 text-center">
        <div class="w-14 h-14 bg-white/15 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <i class="fa-solid fa-building text-white text-2xl"></i>
        </div>
        <h1 class="text-white font-extrabold text-2xl mb-1"><%= t('companies.new.title') %></h1>
        <p class="text-white/70 text-sm"><%= t('companies.new.subtitle') %></p>
      </div>

      <%# Form body %>
      <div class="px-8 py-8">
        <%= form_with model: @company, class: "space-y-5" do |f| %>
          <% if @company.errors.any? %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-2">
              <div class="flex items-start gap-3">
                <i class="fa-solid fa-circle-exclamation text-red-400 mt-0.5 flex-shrink-0"></i>
                <div>
                  <h3 class="text-sm font-bold text-red-700 mb-1">
                    <%= pluralize(@company.errors.count, "error") %> prevented this from being saved:
                  </h3>
                  <ul class="list-disc pl-4 space-y-0.5 text-sm text-red-600">
                    <% @company.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <%# Company name — full width %>
          <div>
            <%= f.label :name, "Company Name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= f.text_field :name, placeholder: "e.g. Andela Kenya",
                class: "arc-input", required: true %>
          </div>

          <%# Description — full width %>
          <div>
            <%= f.label :description, "What does your company do?", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= f.text_area :description, rows: 4, placeholder: "Brief description of your company and how you use Ruby...",
                class: "w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-ruby-500/30 focus:border-ruby-500 resize-none transition-all" %>
          </div>

          <%# Location row %>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :country, "Country", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
              <%= f.text_field :country, placeholder: "e.g. Kenya",
                  class: "arc-input" %>
            </div>
            <div>
              <%= f.label :city, "City", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
              <%= f.text_field :city, placeholder: "e.g. Nairobi",
                  class: "arc-input" %>
            </div>
          </div>

          <%# Website URL %>
          <div>
            <%= f.label :website_url, "Website URL", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <div class="relative">
              <i class="fa-solid fa-globe absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
              <%= f.url_field :website_url, placeholder: "https://yourcompany.com",
                  class: "arc-input pl-10" %>
            </div>
          </div>

          <%# Careers URL %>
          <div>
            <%= f.label :careers_url, "Careers Page (optional)", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <p class="text-gray-400 text-xs mb-1.5">Add this to show a "Hiring" badge on your listing</p>
            <div class="relative">
              <i class="fa-solid fa-briefcase absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
              <%= f.url_field :careers_url, placeholder: "https://yourcompany.com/careers",
                  class: "arc-input pl-10" %>
            </div>
          </div>

          <%# Logo upload %>
          <div>
            <%= f.label :logo, "Company Logo", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <div class="border-2 border-dashed border-gray-200 rounded-xl p-6 text-center hover:border-ruby-300 transition-colors cursor-pointer">
              <i class="fa-regular fa-image text-gray-300 text-3xl mb-2"></i>
              <p class="text-gray-400 text-xs mb-3">PNG, JPG, SVG up to 5MB</p>
              <%= f.file_field :logo, class: "text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-ruby-50 file:text-ruby-600 hover:file:bg-ruby-100 transition-all" %>
            </div>
          </div>

          <%# Submit row %>
          <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
            <%= f.submit t('companies.new.submit_button'),
                class: "w-full arc-btn-ruby justify-center text-base py-3.5 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
