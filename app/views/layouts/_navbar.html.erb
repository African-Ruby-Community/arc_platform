<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-black/80 backdrop-blur-xl"
        id="main-navbar"
        data-turbo-permanent
        data-controller="navbar">

  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

    <%# Logo %>
    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           class="text-red-500">
        <path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"/>
      </svg>
      <span class="text-xl font-bold tracking-tight text-white">ARC</span>
    <% end %>

    <%# Desktop nav links %>
    <ul class="hidden items-center gap-8 md:flex">
      <li><%= link_to 'Home', root_path, class: "text-sm text-zinc-400 transition-colors hover:text-white" %></li>
      <li><%= link_to 'About', landing_about_path, class: "text-sm text-zinc-400 transition-colors hover:text-white" %></li>
      <li><a href="#activities" class="text-sm text-zinc-400 transition-colors hover:text-white">Activities</a></li>
      <li><%= link_to 'Chapters', chapters_path, class: "text-sm text-zinc-400 transition-colors hover:text-white" %></li>
      <li><a href="#featured-sponsors" class="text-sm text-zinc-400 transition-colors hover:text-white">Sponsors</a></li>
      <% if FeatureFlag.find_by(name: 'projects').try(:enabled) %>
        <li><a href="#" class="text-sm text-zinc-400 transition-colors hover:text-white">Projects</a></li>
      <% end %>
    </ul>

    <%# Desktop auth buttons %>
    <div class="hidden items-center gap-2 md:flex">
      <% if user_signed_in? %>
        <% if current_user.organization_admin? %>
          <div class="dropdown dropdown-end">
            <button class="rounded-md px-3 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors">
              Settings
            </button>
            <ul tabindex="0" class="menu dropdown-content p-2 shadow bg-zinc-900 border border-zinc-800 rounded-md w-44 mt-2">
              <li><%= link_to 'Countries', countries_path, class: "text-sm text-zinc-300 hover:text-white" %></li>
              <li><%= link_to 'Chapters', chapters_path, class: "text-sm text-zinc-300 hover:text-white" %></li>
            </ul>
          </div>
        <% end %>
        <div class="dropdown dropdown-end">
          <button class="rounded-md px-3 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors">
            Account
          </button>
          <ul tabindex="0" class="menu dropdown-content p-2 shadow bg-zinc-900 border border-zinc-800 rounded-md w-44 mt-2">
            <li><%= link_to 'Update profile', edit_user_registration_path, class: "text-sm text-zinc-300 hover:text-white" %></li>
          </ul>
        </div>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "rounded-md px-3 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path,
            class: "rounded-md px-3 py-1.5 text-sm text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors font-medium" %>
        <%= link_to "Join Us", new_user_registration_path,
            class: "rounded-md bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700 transition-colors font-medium" %>
      <% end %>
    </div>

    <%# Mobile menu button %>
    <button class="text-zinc-400 hover:text-white transition-colors md:hidden"
            data-action="click->navbar#toggle"
            aria-label="Toggle menu">
      <svg data-navbar-target="openIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
      </svg>
      <svg data-navbar-target="closeIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" class="hidden">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>

  </nav>

  <%# Mobile menu panel %>
  <div data-navbar-target="menu" class="hidden border-t border-white/10 bg-black/95 backdrop-blur-xl md:hidden">
    <div class="flex flex-col gap-1 px-6 py-4">
      <%= link_to 'Home', root_path,
          class: "rounded-lg px-3 py-2.5 text-sm text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-white",
          data: { action: "click->navbar#close" } %>
      <%= link_to 'About', landing_about_path,
          class: "rounded-lg px-3 py-2.5 text-sm text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-white",
          data: { action: "click->navbar#close" } %>
      <a href="#activities" data-action="click->navbar#close"
         class="rounded-lg px-3 py-2.5 text-sm text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-white">Activities</a>
      <%= link_to 'Chapters', chapters_path,
          class: "rounded-lg px-3 py-2.5 text-sm text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-white",
          data: { action: "click->navbar#close" } %>
      <a href="#featured-sponsors" data-action="click->navbar#close"
         class="rounded-lg px-3 py-2.5 text-sm text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-white">Sponsors</a>

      <div class="mt-3 flex flex-col gap-2">
        <% if user_signed_in? %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "w-full rounded-md border border-zinc-700 px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors font-medium" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path,
              class: "rounded-md border border-zinc-700 px-3 py-2 text-sm text-center text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors font-medium" %>
          <%= link_to "Join Us", new_user_registration_path,
              class: "rounded-md bg-red-600 px-3 py-2 text-sm text-center text-white hover:bg-red-700 transition-colors font-medium" %>
        <% end %>
      </div>
    </div>
  </div>

</header>
