<footer class="border-t border-base-300 bg-base-100 text-base-content transition-colors duration-200 font-mono" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-10">

    <%# ── Top Grid ── %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <%# Column 1: Logo + tagline %>
      <div class="md:col-span-1">
        <%= link_to root_path, class: "inline-block transition-transform duration-200 hover:scale-105" do %>
          <%= image_tag('arc_logo_coloured.png', alt: "RubyCommunity Africa Logo", class: 'w-36 mb-4') %>
        <% end %>
        <p class="text-sm text-base-content/80 leading-relaxed">
          <%= t('footer.about_details') %>
        </p>
      </div>

      <%# Column 2: Quick Links %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-base-content/60 mb-4">Community</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <%= link_to t('footer.home'), root_path,
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
          <% if FeatureFlag.find_by(name: 'events').try(:enabled) %>
            <li>
              <%= link_to t('footer.events'), events_path,
                          class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
            </li>
          <% end %>
          <li>
            <%= link_to t('footer.chapters'), chapters_path,
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
          <% if FeatureFlag.find_by(name: 'projects')&.enabled %>
            <li>
              <%= link_to t('footer.projects'), projects_path,
                          class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
            </li>
          <% end %>
          <% if FeatureFlag.find_by(name: 'learning_materials')&.enabled %>
            <li>
              <%= link_to t('footer.learning_materials'), learning_materials_path,
                          class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
            </li>
          <% end %>
        </ul>
      </div>

      <%# Column 3: Resources %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-base-content/60 mb-4">Resources</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <%= link_to t('footer.about'), landing_about_path,
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
          <li>
            <%= link_to t('footer.built_with_ruby'), built_with_ruby_path,
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
<!--          TODO: Replace with sponsor page/ contact page-->
          <li style="display: none;">
            <%= mail_to t('footer.sponsor'), 'mailto:organisers@rubycommunity.africa',
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
          <% if FeatureFlag.find_by(name: 'members').try(:enabled) %>
            <li>
              <%= link_to t('footer.members'), '#',
                          class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
            </li>
          <% end %>
          <li>
            <%= link_to "Code of Conduct", landing_code_of_conduct_path,
                        class: "inline-block text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200" %>
          </li>
        </ul>
      </div>

      <%# Column 4: Social links %>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-base-content/60 mb-4"><%= t('footer.connect') %></h3>
        <div class="flex flex-wrap gap-3">
          <% socials.each do |social| %>
            <% next unless social[:show] %>

            <%= link_to social[:link],
                        target: "_blank",
                        rel: "noopener",
                        class: "w-10 h-10 flex items-center justify-center rounded-full bg-base-200 text-base-content border border-base-content/20 hover:bg-neutral hover:text-neutral-content transition-all duration-200 hover:scale-110 shadow-sm" do %>
              <%= inline_svg social[:icon],
                             class: "w-5 h-5 text-base-content hover:text-neutral-content transition-colors" %>
            <% end %>
          <% end %>
        </div>

        <div class="mt-6 space-y-1.5 text-sm">
          <a href="mailto:organisers@rubycommunity.africa" class="inline-flex items-center gap-2 text-base-content/70 hover:text-red-500 dark:hover:text-red-400 transition-colors duration-200">
            <i class="fa-regular fa-envelope text-xs"></i>
            <span>organisers@rubycommunity.africa</span>
          </a>
        </div>
      </div>
    </div>

    <%# ── Divider ── %>
    <div class="border-t border-base-300 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-base-content/60">
        <%= t('footer.copyright', year: Date.today.year) %>
      </p>
      <p class="text-sm text-base-content/60 flex items-center gap-1">
        <%= t('footer.made_with') %> <span class="text-error text-base inline-block transition-transform duration-200 hover:scale-125 animate-pulse cursor-default">❤️</span> <%= t('footer.by_arc') %>
      </p>
    </div>
  </div>
</footer>