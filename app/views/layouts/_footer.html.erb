<footer class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-white dark:bg-zinc-950 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-6 py-16">

    <div class="grid gap-12 md:grid-cols-4">

      <ul class="flex flex-col gap-3">
        <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.chapters'), chapters_path %></li>
        <% if FeatureFlag.find_by(name: 'projects')&.enabled %>
          <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.projects'), projects_path %></li>
        <% end %>
        <% if FeatureFlag.find_by(name: 'learning_materials')&.enabled %>
          <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.learning_materials'), learning_materials_path %></li>
        <% end %>
      </ul>

      <ul class="flex flex-col gap-3">
      <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.sponsor'), 'mailto:organisers@rubycommunity.africa' %></li>

      <% if FeatureFlag.find_by(name: 'members').try(:enabled) %>
        <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.members'), '#' %></li>
      <% end %>

      <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.about'), landing_about_path %></li>

      <% if FeatureFlag.find_by(name: 'contact_us').try(:enabled) %>
        <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.contact_us'), '#' %></li>
      <% end %>

      <% if FeatureFlag.find_by(name: 'contact_us').try(:enabled) %>
        <li class="hover:text-red-600 hover:underline"><%= link_to t('footer.code_of_conduct'), '#' %></li>
      <% end %>
    </ul>
  </div>

  <div class="flex flex-col justify-center items-center pt-12">
      <h1 class="pt-4 pb-12 md:text-4xl text-2xl text-red-600 font-bold text-center">
        <%= t('footer.connect') %>
      </h1>
      <ul class="flex md:flex-row flex-col md:mt-4 md:gap-10 gap-5">
        <% socials.each do |social| %>
          <% if social[:show] %>
            <li class='md:border-2 border-red-600 p-5 rounded-full'>
              <%= link_to social[:link] do %>
                <%= image_tag social[:image], alt: social[:alt], class: "md:w-5 w-8 hover:scale-105" %>
              <% end %>
            </li>
          <% end %>
        <% end %>
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
        African Ruby Community. Promoting computer software programming
        skills with the Ruby programming language across Africa since 2010.
      </p>
    </div>

      <%# Community links %>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-zinc-900 dark:text-white">
          Community
        </h4>
        <ul class="mt-4 flex flex-col gap-3">
          <li><%= link_to 'About', landing_about_path, class: "text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white" %></li>
          <li><a href="#activities" class="text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white">Activities</a></li>
          <li><a href="#chapters" class="text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white">Chapters</a></li>
          <li><a href="#featured-sponsors" class="text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white">Sponsors</a></li>
        </ul>
      </div>

      <%# Resources links %>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-zinc-900 dark:text-white">
          Resources
        </h4>
        <ul class="mt-4 flex flex-col gap-3">
          <li><%= link_to 'Learning Materials', landing_learn_path, class: "text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white" %></li>
          <li><a href="https://rubyconf.africa" target="_blank" class="text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white">RubyConf Africa</a></li>
          <li><%= link_to 'Sign Up', new_user_registration_path, class: "text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white" %></li>
          <li><%= link_to 'Sign In', new_user_session_path, class: "text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white" %></li>
        </ul>
      </div>

      <%# Social links — driven by the socials helper %>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-zinc-900 dark:text-white">
          Social
        </h4>
        <ul class="mt-4 flex flex-col gap-3">
          <% socials.each do |social| %>
            <% if social[:show] %>
              <li>
                <%= link_to social[:link], target: '_blank',
                    class: "text-sm text-zinc-500 dark:text-zinc-400 transition-colors hover:text-zinc-900 dark:hover:text-white" do %>
                  <%= social[:alt].sub('ARC ', '') %>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>

    </div>

    <%# Bottom bar %>
    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-zinc-200/50 dark:border-zinc-800/50 pt-8 md:flex-row">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        &copy; <%= Date.today.year %> African Ruby Community. All rights reserved.
      </p>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Built with Ruby, powered by community.
      </p>
    </div>

  </div>
</footer>
