<% content_for(:title, t('chapters.index.page_title')) %>
<% content_for(:description, t('chapters.index.page_description')) %>
<% require 'digest' %>
<div class="container pt-20 px-4 xl:px-56 mx-auto">
  <div class="pt-16 pb-6">
    <!-- Country Filter (top) -->
    <div class="mb-8">
      <div class="dropdown">
        <% selected_country = @countries.find { |c| c.id.to_s == @country_param } %>
        <label tabindex="0" class="btn btn-outline gap-2">
          <% if selected_country && country_icon(selected_country.name) %>
            <%= image_tag country_icon(selected_country.name), alt: selected_country.name, class: "w-5 h-5 object-contain" %>
          <% end %>
          <%= selected_country&.name || 'Select Country' %>
          <svg class="fill-current" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/></svg>
        </label>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52 mt-2">
          <% @countries.each do |country| %>
            <li>
              <%= link_to chapters_path(country: country.id), class: "flex items-center gap-2" do %>
                <% if country_icon(country.name) %>
                  <%= image_tag country_icon(country.name), alt: country.name, class: "w-5 h-5 object-contain" %>
                <% end %>
                <span><%= country.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <h1 class="text-4xl text-red-600 font-bold text-5xl">
      <%= t('chapters.index.title') %>
    </h1>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
    <% @chapters.each do |chapter| %>
      <div class="group bg-white rounded-xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden">
        <div class="relative aspect-video overflow-hidden bg-gray-200">
          <%= image_tag chapter.image.attached? ? chapter.image.url : image_path('chapter.jpg'),
                        alt: chapter.name,
                        class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
          %>
        </div>
        
        <div class="p-5 sm:p-6">
          <h3 class="text-xl font-bold mb-2 group-hover:text-red-600 transition-colors"><%= chapter.name %></h3>
        </div>
      <% end %>
    </div>

  </div>
</section>

<%# Start a Chapter CTA %>
<section class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-white dark:bg-zinc-950 py-24 md:py-32 transition-colors duration-300">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-white md:text-5xl mb-6">
      Want to Start a Chapter?
    </h2>
    <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
      Interested in building the Ruby community in your city? We'd love to help you establish
      a new ARC chapter. Connect with us to get started.
    </p>
    <%= link_to new_user_registration_path,
        class: "inline-flex items-center gap-2 rounded-md bg-red-600 px-8 py-3 text-sm font-semibold text-white hover:bg-red-700 transition-colors" do %>
      Get in Touch
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
        <path fill-rule="evenodd" d="M2 10a.75.75 0 01.75-.75h12.59l-2.1-1.95a.75.75 0 111.02-1.1l3.5 3.25a.75.75 0 010 1.1l-3.5 3.25a.75.75 0 11-1.02-1.1l2.1-1.95H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
      </svg>
    <% end %>
  </div>

  <% if @country_param.present? %>
<!--    Hide Featured Members-->
    <!-- Featured Members -->
    <div class="mt-16" style="display: none">
      <h2 class="text-2xl font-bold mb-6">Featured members</h2>
      <% if @featured_members.present? %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @featured_members.each do |member| %>
            <div class="card bg-white shadow">
              <div class="card-body">
                <%# Avatar via Gravatar identicon fallback %>
                <% gravatar = "https://www.gravatar.com/avatar/#{Digest::MD5.hexdigest(member.email.to_s.downcase)}?s=120&d=identicon" %>
                <img src="<%= gravatar %>" alt="<%= member.name %>" class="w-20 h-20 rounded-full object-cover mb-3">
                <p class="font-semibold text-gray-900"><%= member.name %></p>
                <%# Short bio not available on User model; show a subtle placeholder sentence %>
                <p class="text-sm text-gray-600">Member of the community</p>
                <div class="flex items-center gap-4 pt-2">
                  <% if member.github_username.present? %>
                    <a href="https://github.com/<%= member.github_username %>" target="_blank" rel="noopener" class="link link-primary text-sm">github</a>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-blue-50 rounded p-6 text-gray-700">No featured members found for this country.</div>
      <% end %>
    </div>

    <!-- Upcoming Events from that country -->
    <div class="mt-16" style="display: none">
      <h2 class="text-2xl font-bold mb-6">Upcoming events</h2>
      <% if @upcoming_events.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          <% @upcoming_events.each do |event| %>
            <div class="group bg-white rounded-xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden">
              <%= link_to event_path(event), class: "block" do %>
                <div class="relative aspect-video overflow-hidden bg-gray-200">
                  <% if event.image.attached? %>
                    <%= image_tag event.image, class: "w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500", alt: event.title %>
                  <% else %>
                    <div class="w-full h-full bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center">
                      <svg class="w-16 h-16 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  <% end %>
                  
                  <!-- Payment Status Badge -->
                  <% if event.payment_status == 'free' %>
                    <div class="absolute top-3 right-3 bg-green-600 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
                      Free
                    </div>
                  <% elsif event.payment_status == 'paid' %>
                    <div class="absolute top-3 right-3 bg-blue-600 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
                      <%= number_to_currency(event.price_cents / 100.0) %>
                    </div>
                  <% end %>
                </div>
              <% end %>
              
              <div class="p-5 sm:p-6">
                <%= link_to event_path(event) do %>
                  <h3 class="text-xl font-bold mb-2 group-hover:text-red-600 transition-colors line-clamp-2"><%= event.title %></h3>
                <% end %>
                
                <!-- Event Date & Time -->
                <div class="space-y-1 mb-4">
                  <p class="text-sm font-semibold text-gray-900">
                    <%= event.start_datetime.strftime("%B %d, %Y") %>
                  </p>
                  <p class="text-sm text-gray-600">
                    <%= event.start_datetime.strftime("%I:%M %p") %> - <%= event.end_datetime.strftime("%I:%M %p") %>
                    <span class="text-gray-400"><%= event.start_datetime.strftime("%Z") %></span>
                  </p>
                </div>
                
                <!-- Location -->
                <% if event.location_name.present? %>
                  <div class="inline-flex items-center gap-2 px-3 py-1 bg-gray-100 rounded-full text-xs text-gray-700">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span><%= event.location_name %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-blue-50 rounded p-6 text-gray-700">No upcoming events found for this country.</div>
      <% end %>
    </div>
  <% end %>
</div>
