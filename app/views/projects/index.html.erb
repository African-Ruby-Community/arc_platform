<% content_for(:title, "Projects") %>
<% content_for(:description, "Discover amazing open source projects built by the African Ruby Community.") %>
<% content_for :full_width do %><% end %>

<%# Use DB projects when available, fall back to static data %>
<% project_list = @projects.any? ? @projects : static_projects %>

<%# Hero Section %>
<section class="relative flex h-[600px] items-center overflow-hidden -mt-16">
  <div class="absolute inset-0">
    <%= image_tag 'conference.jpg', alt: "Community Projects",
        class: "w-full h-full object-cover" %>
    <div class="absolute inset-0 dark:hidden"
         style="background: linear-gradient(to right, rgba(255,255,255,0.97) 0%, rgba(255,255,255,0.6) 50%, rgba(255,255,255,0.1) 100%)"></div>
    <div class="absolute inset-0 hidden dark:block"
         style="background: linear-gradient(to right, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.5) 50%, transparent 100%)"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 w-full pt-16">
    <div class="max-w-2xl">
      <h1 class="text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white md:text-7xl mb-4">
        Community Projects
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Discover amazing open source projects built by the African Ruby Community.
      </p>
    </div>
  </div>
</section>

<%# Projects Grid %>
<section class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-900 py-24 md:py-32 transition-colors duration-300"
         data-controller="project-search">
  <div class="mx-auto max-w-7xl px-6">

    <%# Search bar %>
    <div class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <span class="text-sm font-medium uppercase tracking-widest text-red-500">Open Source</span>
          <h2 class="mt-1 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
            All Projects
          </h2>
        </div>
        <span class="text-sm text-zinc-500 dark:text-zinc-400"
              data-project-search-target="count">
          <%= project_list.length %> projects
        </span>
      </div>

      <div class="relative">
        <%# Search icon %>
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400 pointer-events-none"
             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text"
               placeholder="Search projects by name, description, or tag…"
               data-project-search-target="input"
               data-action="input->project-search#filter"
               class="w-full h-11 rounded-md border border-zinc-200 dark:border-zinc-700
                      bg-white dark:bg-zinc-800/50
                      pl-10 pr-10 text-sm
                      text-zinc-900 dark:text-white
                      placeholder-zinc-400 dark:placeholder-zinc-500
                      focus:outline-none focus:ring-2 focus:ring-red-500/30 focus:border-red-500/50
                      transition-colors" />
        <%# Clear button — shown via JS when input has value %>
        <button type="button"
                data-action="click->project-search#clear"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors"
                aria-label="Clear search">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% project_list.each do |project| %>
        <%# Support both ActiveRecord objects and hashes %>
        <% p_title  = project.respond_to?(:name)        ? project.name        : project[:title] %>
        <% p_desc   = project.respond_to?(:description) ? project.description : project[:description] %>
        <% p_tags   = project.respond_to?(:tags)        ? project.tags        : project[:tags] %>
        <% p_stars  = project[:stars] rescue nil %>
        <% p_url    = project.respond_to?(:id)          ? project_path(project) : project[:url] %>
        <% p_github = project[:github_url] rescue nil %>

        <div class="group flex flex-col rounded-xl border border-zinc-200/50 dark:border-zinc-700/50
                    bg-white dark:bg-zinc-800/20 p-6
                    hover:border-red-300/50 dark:hover:border-red-500/30
                    hover:bg-zinc-50 dark:hover:bg-zinc-800/40
                    transition-all duration-300"
             data-project-search-target="card"
             data-search-text="<%= [p_title, p_desc, Array(p_tags).join(' ')].join(' ') %>">

          <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-2 group-hover:text-red-500 transition-colors">
            <%= p_title %>
          </h3>

          <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4 leading-relaxed flex-1">
            <%= p_desc %>
          </p>

          <% if p_stars.present? %>
            <div class="flex items-center gap-2 mb-4">
              <svg class="h-4 w-4 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                   fill="currentColor">
                <path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
              </svg>
              <span class="text-sm text-zinc-500 dark:text-zinc-400"><%= p_stars %> stars</span>
            </div>
          <% end %>

          <% if p_tags.present? %>
            <div class="flex flex-wrap gap-2 mb-6">
              <% Array(p_tags).each do |tag| %>
                <span class="inline-flex items-center rounded-full bg-red-500/10 px-2.5 py-0.5 text-xs font-medium text-red-500">
                  <%= tag %>
                </span>
              <% end %>
            </div>
          <% end %>

          <div class="flex gap-2 mt-auto">
            <%= link_to p_url,
                class: "flex flex-1 items-center justify-center gap-2 rounded-md border border-zinc-200 dark:border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:border-red-400/50 hover:text-red-500 dark:hover:border-red-500/40 dark:hover:text-red-400 transition-colors group/btn" do %>
              View Project
              <svg class="h-4 w-4 transition-transform group-hover/btn:translate-x-0.5" xmlns="http://www.w3.org/2000/svg"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              </svg>
            <% end %>
            <% if p_github.present? %>
              <%= link_to p_github, target: "_blank", rel: "noopener noreferrer",
                  class: "flex items-center justify-center rounded-md border border-zinc-200 dark:border-zinc-700 px-3 py-2 text-zinc-500 dark:text-zinc-400 hover:border-red-400/50 hover:text-red-500 dark:hover:text-red-400 transition-colors" do %>
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              <% end %>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>

    <%# Empty state — shown by JS when no results match %>
    <div data-project-search-target="empty"
         style="display:none"
         class="py-20 text-center">
      <svg class="mx-auto h-10 w-10 text-zinc-300 dark:text-zinc-600 mb-4" xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <p class="text-zinc-500 dark:text-zinc-400 font-medium">No projects match your search.</p>
      <p class="text-sm text-zinc-400 dark:text-zinc-500 mt-1">Try a different keyword or clear the search.</p>
    </div>

  </div>
</section>

<%# Contribute CTA %>
<section class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-white dark:bg-zinc-950 py-24 md:py-32 transition-colors duration-300">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-white md:text-5xl mb-6">
      Have a Project to Share?
    </h2>
    <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8 leading-relaxed">
      Built something awesome? We'd love to showcase your Ruby project to the community.
      Submit your project and connect with other developers.
    </p>
    <%= link_to new_user_registration_path,
        class: "inline-flex items-center gap-2 rounded-md bg-red-600 px-8 py-3 text-sm font-semibold text-white hover:bg-red-700 transition-colors" do %>
      Submit Your Project
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
        <path fill-rule="evenodd" d="M2 10a.75.75 0 01.75-.75h12.59l-2.1-1.95a.75.75 0 111.02-1.1l3.5 3.25a.75.75 0 010 1.1l-3.5 3.25a.75.75 0 11-1.02-1.1l2.1-1.95H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
      </svg>
    <% end %>
  </div>
</section>
