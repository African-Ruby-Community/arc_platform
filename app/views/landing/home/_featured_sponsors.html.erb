<section id="featured-sponsors" class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-900 py-24 md:py-32 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-6">

    <%# Header %>
    <div class="text-center">
      <span class="text-sm font-medium uppercase tracking-widest text-red-500">
        Supported by
      </span>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-white md:text-5xl">
        Our Sponsors
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-zinc-500 dark:text-zinc-400">
        We are grateful to the organizations that support the growth of the
        Ruby ecosystem in Africa.
      </p>
    </div>

    <%# Featured sponsors %>
    <div class="mt-20">
      <h3 class="mb-12 text-center text-sm font-medium uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
        Featured Sponsors
      </h3>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        <% featured_sponsors.each do |sponsor| %>
          <%= link_to sponsor[:link], target: '_blank',
              class: "group flex items-center justify-center rounded-2xl border border-zinc-200/40 dark:border-zinc-700/40 bg-white/20 dark:bg-zinc-800/20 p-8 transition-all duration-300 hover:border-red-400/40 dark:hover:border-red-500/40 hover:bg-white dark:hover:bg-zinc-800/40 hover:shadow-lg" do %>
            <div class="text-center">
              <div class="mb-3 flex h-12 w-full items-center justify-center">
                <%= image_tag sponsor[:image], alt: sponsor[:alt],
                    class: "max-h-12 w-auto max-w-full object-contain transition-opacity group-hover:opacity-100 opacity-70 dark:opacity-50 dark:group-hover:opacity-80" %>
              </div>
              <p class="text-xs font-medium text-zinc-400 dark:text-zinc-500 transition-colors group-hover:text-zinc-700 dark:group-hover:text-zinc-300">
                <%= sponsor[:alt] %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Previous sponsors %>
    <div class="mt-20">
      <h3 class="mb-12 text-center text-sm font-medium uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
        Previous Sponsors
      </h3>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        <% previous_sponsors.each do |sponsor| %>
          <%= link_to sponsor[:link], target: '_blank',
              class: "group flex items-center justify-center rounded-xl border border-zinc-200/30 dark:border-zinc-700/30 bg-white/10 dark:bg-zinc-800/10 p-6 transition-all duration-300 hover:border-red-400/30 dark:hover:border-red-500/30 hover:bg-white/20 dark:hover:bg-zinc-800/20" do %>
            <div class="text-center">
              <div class="mb-2 flex h-10 w-full items-center justify-center">
                <%= image_tag sponsor[:image], alt: sponsor[:alt],
                    class: "max-h-10 w-auto max-w-full object-contain opacity-50 dark:opacity-30 transition-opacity group-hover:opacity-70 dark:group-hover:opacity-50" %>
              </div>
              <p class="text-xs font-medium text-zinc-400/70 dark:text-zinc-600 transition-colors group-hover:text-zinc-500 dark:group-hover:text-zinc-400">
                <%= sponsor[:alt] %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# CTA %>
    <div class="mt-20 flex justify-center">
      <a href="mailto:organisers@rubycommunity.africa"
         class="inline-flex items-center gap-2 bg-red-600 text-white text-base px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition-colors">
        Become a Sponsor
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
