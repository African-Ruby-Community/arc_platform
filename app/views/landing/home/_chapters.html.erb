<div id="chapters" class="py-24 md:py-32" style="background-image: url(<%= image_path('countries.png') %>); background-size: cover; background-position: center;">
  <div style="background: rgba(0,0,0,0.55);" class="py-12">
    <h2 class="pb-12 text-4xl font-bold text-center text-white tracking-tight">
      Chapters
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5 px-8 md:px-20 place-content-center">
      <% chapters.each do |chapter| %>
        <%= link_to new_user_registration_path,
            class: 'place-self-center w-72 md:w-48 rounded-xl border border-white/20 bg-white/10 backdrop-blur-sm flex flex-col gap-4 hover:scale-95 hover:bg-white/20 transition-all p-3' do %>
          <%= image_tag chapter[:image], alt: chapter[:alt], class: 'pt-2 place-self-center h-16' %>
          <p class="text-center text-2xl text-white font-semibold"><%= chapter[:country] %></p>
          <p class="place-self-center pb-6 text-white/80 text-sm hover:underline font-medium">Join community</p>
        <% end %>
      <% end %>

      <a href="mailto:organisers@rubycommunity.africa"
         class="place-self-center w-72 md:w-48 rounded-xl border border-white/20 bg-white/10 backdrop-blur-sm flex flex-col gap-4 hover:scale-95 hover:bg-white/20 transition-all p-3">
        <%= image_tag 'add.png', alt: "Add Chapter", class: 'pt-2 place-self-center h-16' %>
        <p class="text-center text-xl text-white font-semibold">Request new chapter</p>
        <p class="pb-6"></p>
      </a>
    </div>
  </div>
</div>
