<div class="py-24 md:py-32 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="pb-12 text-4xl font-bold text-center text-zinc-900 dark:text-white tracking-tight">
      Previous Sponsors
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 place-content-center max-w-2xl mx-auto">
      <% previous_sponsors.each do |sponsor| %>
        <%= link_to sponsor[:link], target: '_blank' do %>
          <div class="flex items-center justify-center rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 p-6 hover:border-red-300 dark:hover:border-red-500/50 transition-colors">
            <%= image_tag sponsor[:image], alt: sponsor[:alt], class: 'max-h-12 w-auto object-contain' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="flex justify-center pt-12">
      <a href="mailto:organisers@rubycommunity.africa"
         class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition-colors text-sm">
        Become a sponsor
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M2 10a.75.75 0 01.75-.75h12.59l-2.1-1.95a.75.75 0 111.02-1.1l3.5 3.25a.75.75 0 010 1.1l-3.5 3.25a.75.75 0 11-1.02-1.1l2.1-1.95H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </div>
</div>
