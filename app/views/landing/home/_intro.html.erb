<section class="relative flex min-h-screen items-center overflow-hidden -mx-8 -mt-16 pt-20">

  <%# Background image %>
  <div class="absolute inset-0 z-0">
    <%= image_tag 'hero-community.jpg', alt: "African Ruby Community gathering",
        class: "w-full h-full object-cover" %>
    <%# Flat dark overlay — matches bg-background/85 %>
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.85);"></div>
    <%# Top-and-bottom gradient — matches bg-gradient-to-b from-background via-transparent to-background %>
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, #000 0%, transparent 40%, transparent 60%, #000 100%);"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-24 md:py-32">
    <div class="max-w-3xl">

      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-500/10 px-4 py-1.5 text-sm text-red-500">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-red-500"></span>
        RubyConf Africa 2025
      </div>

      <h1 class="text-5xl font-extrabold leading-tight tracking-tight text-white md:text-7xl lg:text-8xl">
        Building the future
        <span class="text-red-500">with Ruby</span>
        in Africa.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-400 md:text-xl">
        A community of 5,000+ developers, entrepreneurs, and designers across
        East Africa united by their passion for Ruby and open-source software.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <%= link_to new_user_registration_path,
            class: "inline-flex items-center justify-center gap-2 bg-red-600 text-white text-base px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition-colors" do %>
          Join the Community
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M2 10a.75.75 0 01.75-.75h12.59l-2.1-1.95a.75.75 0 111.02-1.1l3.5 3.25a.75.75 0 010 1.1l-3.5 3.25a.75.75 0 11-1.02-1.1l2.1-1.95H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
          </svg>
        <% end %>

        <%= link_to landing_about_path,
            class: "inline-flex items-center justify-center text-base px-6 py-3 rounded-md font-semibold border border-zinc-600 text-zinc-200 hover:bg-zinc-800 hover:text-white transition-colors" do %>
          Learn More
        <% end %>
      </div>

    </div>
  </div>

</section>
