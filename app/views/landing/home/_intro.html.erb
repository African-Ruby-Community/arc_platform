<section class="relative -mx-8 overflow-hidden" style="min-height: 88vh;">
  <%= image_tag 'hero-community.jpg', alt: "ARC Community Event", class: "absolute inset-0 w-full h-full object-cover object-center" %>
  <div class="absolute inset-0 bg-black/90"></div>

  <div class="relative z-10 flex flex-col justify-end h-full px-8 md:px-16 lg:px-24 pb-16 md:pb-24" style="min-height: 88vh;">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 text-white/90 text-xs font-medium px-3 py-1.5 rounded-full mb-8 border border-red-500/50 bg-red-600/10 w-fit tracking-wide uppercase">
        <span class="w-1.5 h-1.5 bg-red-500 rounded-full inline-block"></span>
        RubyConf Africa 2025
      </span>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-[1.05] tracking-tight mb-6">
        Building the<br>
        future <span class="text-red-500">with Ruby</span><br>
        in Africa.
      </h1>

      <p class="text-zinc-400 text-base md:text-lg mb-10 max-w-md leading-relaxed font-normal">
        A community of 5,000+ developers, entrepreneurs, and
        designers across East Africa united by their passion for Ruby
        and open-source software.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <%= link_to new_user_registration_path,
            class: "inline-flex items-center gap-2 bg-red-600 text-white text-sm px-5 py-2.5 rounded-full font-semibold hover:bg-red-700 transition-colors tracking-wide" do %>
          Join the Community
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M2 10a.75.75 0 01.75-.75h12.59l-2.1-1.95a.75.75 0 111.02-1.1l3.5 3.25a.75.75 0 010 1.1l-3.5 3.25a.75.75 0 11-1.02-1.1l2.1-1.95H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
          </svg>
        <% end %>

        <%= link_to landing_about_path,
            class: "inline-flex items-center text-zinc-300 text-sm font-medium px-4 py-2.5 hover:text-white transition-colors tracking-wide" do %>
          Learn More
        <% end %>
      </div>
    </div>
  </div>
</section>
