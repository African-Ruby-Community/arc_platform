<div class="py-24 md:py-32">
  <h2 id="activities" class="pb-10 text-4xl font-bold text-center text-zinc-900 dark:text-white tracking-tight">
    Activities
  </h2>

  <div class="grid md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5 px-8 place-content-center">
    <% activities.each do |activity| %>
      <div class="place-self-center w-72 h-72 md:w-full md:h-60 rounded flex flex-col gap-4">
        <%= image_tag activity[:image], alt: activity[:title], class: 'hover:scale-105 transition-transform' %>
        <p class="text-center text-xl md:text-base capitalize font-semibold text-zinc-700 dark:text-zinc-300">
          <%= activity[:title] %>
        </p>
      </div>
    <% end %>
  </div>
</div>
