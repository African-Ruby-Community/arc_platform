<section id="activities" class="border-t border-zinc-200/50 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-900 py-24 md:py-32 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-6">

    <%# Header %>
    <div class="text-center">
      <span class="text-sm font-medium uppercase tracking-widest text-red-500">
        What we do
      </span>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-white md:text-5xl">
        Activities
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-zinc-500 dark:text-zinc-400">
        From local meetups to continental conferences, we create spaces for
        developers to learn, grow, and build together.
      </p>
    </div>

    <%# Activity cards %>
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

      <%# Local Meetups %>
      <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/50 dark:border-zinc-700/50 bg-white/50 dark:bg-zinc-800/30 p-8 transition-colors hover:border-red-300/50 dark:hover:border-red-500/30 hover:bg-white dark:hover:bg-zinc-800/60">
        <div class="mb-5 inline-flex rounded-xl bg-red-500/10 p-3 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Local Meetups</h3>
        <p class="mt-2 leading-relaxed text-zinc-500 dark:text-zinc-400">
          Weekly and monthly gatherings in cities across East Africa where developers share knowledge and network.
        </p>
      </div>

      <%# Conferences %>
      <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/50 dark:border-zinc-700/50 bg-white/50 dark:bg-zinc-800/30 p-8 transition-colors hover:border-red-300/50 dark:hover:border-red-500/30 hover:bg-white dark:hover:bg-zinc-800/60">
        <div class="mb-5 inline-flex rounded-xl bg-red-500/10 p-3 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/>
            <path d="m7 21 5-5 5 5"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Conferences</h3>
        <p class="mt-2 leading-relaxed text-zinc-500 dark:text-zinc-400">
          RubyConf Africa brings together the best minds in the Ruby ecosystem for talks, workshops, and collaboration.
        </p>
      </div>

      <%# Programming %>
      <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/50 dark:border-zinc-700/50 bg-white/50 dark:bg-zinc-800/30 p-8 transition-colors hover:border-red-300/50 dark:hover:border-red-500/30 hover:bg-white dark:hover:bg-zinc-800/60">
        <div class="mb-5 inline-flex rounded-xl bg-red-500/10 p-3 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Programming</h3>
        <p class="mt-2 leading-relaxed text-zinc-500 dark:text-zinc-400">
          Collaborative coding sessions, pair programming, and open-source contributions to the global Ruby ecosystem.
        </p>
      </div>

      <%# Workshops %>
      <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/50 dark:border-zinc-700/50 bg-white/50 dark:bg-zinc-800/30 p-8 transition-colors hover:border-red-300/50 dark:hover:border-red-500/30 hover:bg-white dark:hover:bg-zinc-800/60">
        <div class="mb-5 inline-flex rounded-xl bg-red-500/10 p-3 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Workshops</h3>
        <p class="mt-2 leading-relaxed text-zinc-500 dark:text-zinc-400">
          Hands-on workshops for all skill levels, from Ruby fundamentals to advanced Rails development.
        </p>
      </div>

      <%# Hackathons %>
      <div class="group relative overflow-hidden rounded-2xl border border-zinc-200/50 dark:border-zinc-700/50 bg-white/50 dark:bg-zinc-800/30 p-8 transition-colors hover:border-red-300/50 dark:hover:border-red-500/30 hover:bg-white dark:hover:bg-zinc-800/60">
        <div class="mb-5 inline-flex rounded-xl bg-red-500/10 p-3 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Hackathons</h3>
        <p class="mt-2 leading-relaxed text-zinc-500 dark:text-zinc-400">
          Competitive hackathons challenging developers to build innovative solutions using Ruby technologies.
        </p>
      </div>

    </div>

    <%# Bottom banner image %>
    <div class="mt-16 overflow-hidden rounded-2xl">
      <div class="relative h-64 md:h-80">
        <%= image_tag 'workshop.jpg', alt: "Ruby Community workshop in action",
            class: "absolute inset-0 w-full h-full object-cover" %>
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 60%);"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <p class="text-2xl font-bold text-white md:text-3xl">
            Bridging the gap between education and industry.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>
