<section class="-mx-8 border-y border-zinc-800/50 bg-zinc-900">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-zinc-800/50 md:grid-cols-4">
    <div class="px-6 py-10 text-center md:py-14">
      <div class="text-3xl font-bold text-red-500 md:text-4xl">5,000+</div>
      <div class="mt-2 text-sm text-zinc-400">Members across East Africa</div>
    </div>
    <div class="px-6 py-10 text-center md:py-14">
      <div class="text-3xl font-bold text-red-500 md:text-4xl"><%= Time.now.year - 2010 %>+</div>
      <div class="mt-2 text-sm text-zinc-400">Years of Ruby community</div>
    </div>
    <div class="px-6 py-10 text-center md:py-14">
      <div class="text-3xl font-bold text-red-500 md:text-4xl"><%= chapters.length %></div>
      <div class="mt-2 text-sm text-zinc-400">Active chapters</div>
    </div>
    <div class="px-6 py-10 text-center md:py-14">
      <div class="text-3xl font-bold text-red-500 md:text-4xl">100+</div>
      <div class="mt-2 text-sm text-zinc-400">Events organized</div>
    </div>
  </div>
</section>
