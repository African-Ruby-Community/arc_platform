<a href="<%= resource[:url] %>" target="_blank" rel="noopener noreferrer"
   class="group flex flex-col rounded-xl border border-zinc-200/50 dark:border-zinc-700/50
          bg-zinc-50 dark:bg-zinc-800/20 p-5
          hover:border-red-300/50 dark:hover:border-red-500/30
          hover:bg-white dark:hover:bg-zinc-800/50
          transition-all duration-200">
  <div class="flex items-start justify-between gap-3 mb-2">
    <span class="text-sm font-semibold text-zinc-900 dark:text-white group-hover:text-red-500 transition-colors leading-snug">
      <%= resource[:title] %>
    </span>
    <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-zinc-400 group-hover:text-red-500 transition-colors"
         xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
    </svg>
  </div>
  <% if resource[:desc].present? %>
    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed"><%= resource[:desc] %></p>
  <% end %>
</a>
