<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-white">

  <!-- TOP ROW: Image (left 2/3) + Details Card (right 1/3) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">

    <!-- Image -->
    <div class="lg:col-span-2 rounded-xl overflow-hidden">
      <% if @event.image.attached? %>
        <%= image_tag @event.image, class: "w-full h-80 object-cover rounded-xl" %>
      <% else %>
        <div class="w-full h-80 bg-gray-200 rounded-xl"></div>
      <% end %>
    </div>

    <!-- Event Details Card -->
    <div class="lg:col-span-1">
      <div class="card bg-white shadow-lg h-full">
        <div class="card-body space-y-5">
          <h3 class="card-title text-xl"><%= t('events.show.event_details') %></h3>

          <div>
            <p class="text-sm text-gray-500 mb-1"><%= t('events.show.date') %></p>
            <p class="font-semibold text-lg"><%= @event.start_datetime.strftime("%B %d, %Y") %></p>
          </div>

          <div>
            <p class="text-sm text-gray-500 mb-1"><%= t('events.show.time') %></p>
            <p class="font-semibold">
              <%= @event.start_datetime.strftime("%I:%M %p") %> - <%= @event.end_datetime.strftime("%I:%M %p") %>
            </p>
            <p class="text-sm text-gray-400"><%= @event.start_datetime.strftime("%Z") %></p>
          </div>

          <div>
            <p class="text-sm text-gray-500 mb-1"><%= t('events.show.event_type') %></p>
            <p class="font-semibold"><%= @event.event_type.to_s.titleize %></p>
          </div>

          <% if @event.payment_status == 'paid' %>
            <div>
              <p class="text-sm text-gray-500 mb-1"><%= t('events.show.price') %></p>
              <p class="font-semibold text-lg"><%= number_to_currency(@event.price_cents / 100.0) %></p>
            </div>
          <% else %>
            <div>
              <p class="font-semibold text-lg text-green-600"><%= t('events.show.free_event') %></p>
            </div>
          <% end %>

          <div class="divider my-1"></div>

          <%# Temporarily hidden - will be implemented later %>
          <%# <div class="space-y-3"> %>
          <%#   <%= link_to t('events.show.add_to_calendar'), "#", class: "btn btn-outline btn-block" %>
          <%#   <%= link_to t('events.show.attend_event'), "#", class: "btn btn-primary btn-block" %>
          <%# </div> %>
        </div>
      </div>
    </div>
  </div>

  <!-- TITLE: below image, never overlapping -->
  <h1 class="text-3xl text-red-600 md:text-4xl font-bold mb-8"><%= @event.title %></h1>

  <!-- BODY CONTENT: full width -->
  <div class="space-y-10">

    <!-- About -->
    <div>
      <h2 class="text-2xl font-bold mb-4"><%= t('events.show.about') %></h2>
      <div class="prose max-w-none text-gray-700">
        <%= simple_format(@event.description) %>
      </div>
    </div>

    <!-- Location + Map -->
    <div>
      <h2 class="text-2xl font-bold mb-4"><%= t('events.show.location') %></h2>
      <p class="text-gray-700 text-lg mb-4"><%= @event.location_name || t('events.show.location_tba') %></p>

      <% if @event.mappable? %>
        <div id="event-map" class="w-full h-96 rounded-lg border border-gray-200 mb-4"></div>
        <a href="https://www.google.com/maps/dir/?api=1&destination=<%= @event.latitude %>,<%= @event.longitude %>" 
           target="_blank" rel="noopener" class="btn btn-outline btn-primary">
          <%= t('events.show.get_directions') %>
        </a>
      <% end %>
    </div>

    <!-- Speakers -->
    <% if @event.speakers.any? %>
      <div>
        <h3 class="text-2xl font-bold mb-6"><%= t('events.show.speakers') %></h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% @event.speakers.each do |speaker| %>
            <div class="text-center">
              <% if speaker.photo.attached? %>
                <%= image_tag speaker.photo, class: "w-24 h-24 rounded-full mx-auto mb-3 object-cover" %>
              <% else %>
                <div class="w-24 h-24 bg-gray-300 rounded-full mx-auto mb-3"></div>
              <% end %>
              <p class="font-semibold text-gray-900"><%= speaker.name %></p>
              <p class="text-sm text-gray-600"><%= truncate(speaker.bio, length: 100) %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Share -->
    <div>
      <h3 class="font-semibold text-gray-900 mb-3"><%= t('events.show.share_event') %></h3>
      <div class="flex items-center gap-4">
        <a class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border-2 text-white bg-[#1DA1F2] hover:bg-[#1a8cd8] transition-colors"
           href="https://twitter.com/intent/tweet?text=<%= CGI.escape(@event.title) %>&url=<%= CGI.escape(request.original_url) %>"
           target="_blank" rel="noopener">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
          Twitter
        </a>
        <a class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border-2 text-white bg-[#1877F2] hover:bg-[#166fe5] transition-colors"
           href="https://www.facebook.com/sharer/sharer.php?u=<%= CGI.escape(request.original_url) %>"
           target="_blank" rel="noopener">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </a>
        <a class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border-2 text-white bg-[#0A66C2] hover:bg-[#095196] transition-colors"
           href="https://www.linkedin.com/sharing/share-offsite/?url=<%= CGI.escape(request.original_url) %>"
           target="_blank" rel="noopener">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Related Events -->
    <% if @related_events.present? && @related_events.any? %>
      <div>
        <h4 class="text-xl font-bold mb-4"><%= t('events.show.other_events') %></h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @related_events.each do |event| %>
            <%= link_to event_path(event), class: "block p-4 border border-gray-200 rounded-lg hover:border-red-500 hover:bg-red-50 transition" do %>
              <p class="font-semibold text-gray-900 mb-1"><%= event.title %></p>
              <p class="text-sm text-gray-600"><%= event.start_datetime.strftime("%B %d, %Y") %></p>
              <p class="text-sm text-gray-600"><%= event.location_name || t('events.show.location_tba') %></p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>

<% if @event.mappable? %>
<script>
document.addEventListener('turbo:load', initMap);
document.addEventListener('DOMContentLoaded', initMap);

function initMap() {
  const mapEl = document.getElementById('event-map');
  if (mapEl && !mapEl._leaflet_id) {
    const map = L.map('event-map').setView([<%= @event.latitude %>, <%= @event.longitude %>], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(map);
    L.marker([<%= @event.latitude %>, <%= @event.longitude %>])
      .addTo(map)
      .bindPopup('<strong><%= j @event.title %></strong><br><%= j @event.location_name %>')
      .openPopup();
  }
}
</script>
<% end %>
